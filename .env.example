# Copie de ce fichier en .env et changer le MDP
# Fichier .env jamais commité (voir .gitignore)
APP_ENV=dev
APP_URL=http://localhost:8080

DB_HOST=db
DB_PORT=5432
DB_NAME=vite_gourmand
DB_USER=vite_gourmand
DB_PASSWORD=change-moi

MONGO_URI=mongodb://mongo:27017
MONGO_DB=vite_gourmand_stats
ORS_API_KEY=

# Mails : Mailpit en local, Brevo en production
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_ENCRYPTION=
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=adresse-verifiee-sur-brevo@exemple.fr
MAIL_FROM_NAME="Vite & Gourmand"
MAIL_CONTACT=adresse-qui-recoit-le-formulaire@exemple.fr

# Jeton de la page sante.php (vide = page fermée)
SANTE_JETON=
